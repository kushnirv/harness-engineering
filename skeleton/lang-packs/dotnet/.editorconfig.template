# .editorconfig для <PROJECT_NAME> — severity поднята ЯВНО.
#
# Зачем этот файл вообще. Правила в `rules/lang/dotnet.md` — для агента и человека, сборка их
# не проверяет. Из перечисленного там default-enabled диагностик почти нет: `async void` не
# ловится вообще, `CA1849` и `CA2007` по умолчанию выключены, `CA2254` идёт как suggestion и
# в вывод `dotnet build` не попадает. В референсных конфигах Microsoft почти всё стоит
# `:suggestion` — то есть правило формально есть, а гейта нет.
#
# Здесь severity поднята до `error`, чтобы гейт (`GATE_CMD` с `-warnaserror`) реально краснел.
# Каждая строка — осознанный выбор с ценой: `error` останавливает сборку, включая чужой
# легаси-код. Заводишь на существующем проекте — включай по одной, а не всё сразу.

root = true

[*.cs]
indent_style = space
indent_size = 4
charset = utf-8
insert_final_newline = true
end_of_line = lf

# --- Анализ включён и завязан на сборку -------------------------------------------
# Без этих трёх строк большая часть CA-правил не запускается вовсе.
dotnet_analyzer_diagnostic.category-reliability.severity = warning
dotnet_analyzer_diagnostic.category-usage.severity = warning

# --- Асинхронность ---------------------------------------------------------------
# Sync-over-async: голодание пула потоков под нагрузкой. По умолчанию ВЫКЛЮЧЕНО.
dotnet_diagnostic.CA1849.severity = error
# ConfigureAwait в коде приложения. В ASP.NET Core нет SynchronizationContext, вызов
# бессмыслен → в приложении правило держим выключенным, в переносимой библиотеке
# включаем как error. Строку ниже меняй под тип проекта, а не копируй вслепую.
dotnet_diagnostic.CA2007.severity = none
# Task возвращён, но не дождались — типичная причина «работает локально, теряется в проде».
dotnet_diagnostic.CS4014.severity = error

# --- Логи ------------------------------------------------------------------------
# Шаблон лога должен быть константой, а не интерполяцией. По умолчанию suggestion,
# то есть в выводе сборки не виден.
dotnet_diagnostic.CA2254.severity = error

# --- Nullable --------------------------------------------------------------------
# NRT-предупреждения как ошибки: иначе аннотации превращаются в украшение.
# Требует `<Nullable>enable</Nullable>` в csproj — сам editorconfig его не включает.
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error

# --- Одноразовые объекты ---------------------------------------------------------
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA1063.severity = warning

# --- Что НЕ включаем и почему ----------------------------------------------------
# `async void` собственной диагностики не имеет — ни включить, ни выключить. Ловится
# ревью и грепом; проверку на него в гейт добавляют отдельной командой, не severity.
# Порядок middleware: автоматически ловится ровно один случай (ASP0001 —
# UseAuthorization до UseRouting). Порядок ExceptionHandler/HSTS/StaticFiles и взаимный
# порядок CORS ↔ Authorization не проверяет ничто, только глаза.

[*.{csproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2
