#!/usr/bin/env sh
# Шим для husky. Вся логика Яруса 3 — в .claude/guards/pre-push.sh, чтобы она
# версионировалась и доезжала до инстанса обоими каналами доставки.
#
# Этот файл нужен только Node-командам, которые шарят хуки через husky. Одиночная
# установка обходится без него: bootstrap ставит .git/hooks/pre-push напрямую.
# Husky v9: строка sourcing не нужна.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
sh "${REPO_ROOT}/.claude/guards/pre-push.sh"
