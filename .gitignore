# macOS
.DS_Store

# Сторонние методологии — не часть шаблона (см. rules/common/methodology-routing.md)
.superpowers/

# Copier: артефакт рендера, если случайно запущен в корне шаблона
# (skeleton/.copier-answers.yml.jinja — НЕ игнорировать, это источник)
/.copier-answers.yml

# Node (защитно — в шаблоне нет, но инстансы тянут)
node_modules/
*.log

# Локальное окружение
.env
.env.local

# Временные/скретч
*.orig
*.tmp

# Внутренняя операционка / приватное — не в публичный шаблон.
# Низкая чувствительность → без scrub истории (остаются в прошлых коммитах).
# Файлы остаются ЛОКАЛЬНО (полезны), уходят из трекинга через git rm --cached.
/REGISTRY.md
/docs/plans/
/docs/specs/
/skeleton/.claude/rules/lang/md-libs.md
# Ресёрч и факт-чеки под план — провенанс решений, нужен локально, потребителю нет.
# Именно они цитируют номера ADR и плейсхолдеры, из-за чего проверка ADR требует
# --exclude-dir=reports (см. docs/plans/, единица Е6).
/reports/
# Мультирепный план подъёма в инстанс — операционка, живёт вне /docs/plans/ по истории.
/docs/plan-contribute-fenris-2026-07-14.md
# Буфер /note этой репы — операционка, разбирается в /end-session и уезжает
# в docs/plans/ (тоже игнор) или в вику. В публичном шаблоне ему делать нечего.
/.claude/PENDING-NOTES.md
